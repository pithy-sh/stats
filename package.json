{
  "name": "stats",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "pithy": "pithy",
    "dev": "pithy dev",
    "deploy": "pithy deploy",
    "deploy:staging": "pithy deploy --env staging",
    "deploy:prod": "pithy deploy --env prod",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@pithy-sh/cli": "^0.24.1",
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@pithy-sh/secrets": "^0.6.8"
  }
}
